<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="KeyPressMirror.MainWindow"
        Title="KeyPress Mirror"
        Width="680"
        Height="500"
        MinWidth="520"
        MinHeight="400"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="32">
    <StackPanel Spacing="6">
      <TextBlock Text="KeyPress Mirror" FontSize="28" FontWeight="SemiBold" />
      <TextBlock Text="Type a saved phrase or create a new one, then send it to the active cursor." Opacity="0.65" />
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,28,0,0" Spacing="8">
      <TextBlock Text="Phrase" FontWeight="SemiBold" />
      <ComboBox x:Name="PhraseSelector"
                IsEditable="True"
                PlaceholderText="Type a phrase or choose a saved one"
                SelectionChanged="PhraseSelector_OnSelectionChanged" />
    </StackPanel>

    <Grid Grid.Row="2" Margin="0,22,0,0" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalAlignment="Top">
      <TextBlock Text="Saved phrases" FontWeight="SemiBold" />
      <Button Grid.Column="1" Content="Save current" Click="SaveCurrent_OnClick" />
      <ListBox x:Name="SavedPhrases" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Height="150" SelectionChanged="SavedPhrases_OnSelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto" Margin="4">
              <TextBlock Text="{Binding Name}" />
              <Button Grid.Column="1" Content="Remove" Tag="{Binding}" Click="Remove_OnClick" Padding="10,4" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,26,0,0">
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="Send to cursor" Click="SendToCursor_OnClick" Padding="22,11" IsDefault="True" />
    </Grid>
  </Grid>
</Window>